---
/* A Burrow Mole concept rendering: WebP with JPEG fallback, responsive srcset,
   real width/height and one compact, honest caption.
   The images carry their own on-image caption at the bottom-left (and the turnaround
   sheet a notice at the top-right), so they are never cropped or overlaid:
   they keep their intrinsic aspect ratio. */
import { conceptImage, type ConceptRole } from '../data/concept';
import { translator, type Locale } from '../i18n/translate';

interface Props {
  locale: Locale;
  role: ConceptRole;
  /** `sizes` attribute describing the rendered width. */
  sizes: string;
  /** Short visible label, e.g. "Front" or "Face close-up". */
  label?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** Add a link to the largest JPEG (for detailed sheets). */
  fullSizeLink?: boolean;
}
const { locale, role, sizes, label, loading = 'lazy', fetchpriority, class: className, fullSizeLink = false } = Astro.props;
const t = translator(locale);
const img = conceptImage(role);
const hasSlot = Astro.slots.has('default');
---
<figure class:list={['concept-figure', className]}>
  <picture>
    <source type="image/webp" srcset={img.webpSrcset} sizes={sizes} />
    <img src={img.src} srcset={img.jpgSrcset} sizes={sizes} width={img.width} height={img.height} alt={t(img.alt)} loading={loading} decoding={loading === 'eager' ? 'sync' : 'async'} fetchpriority={fetchpriority} />
  </picture>
  <figcaption>
    {label && <strong>{label}</strong>}
    {hasSlot ? <slot /> : <span>{label ? '· ' : ''}{t('3D concept, not a manufactured sample.')}</span>}
    {fullSizeLink && (
      <a href={img.full.href}>{t('Open the full-size sheet')} <span>({img.full.width} × {img.full.height} px JPEG, {img.full.kb} KB)</span></a>
    )}
  </figcaption>
</figure>
