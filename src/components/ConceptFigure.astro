---
/* An original-concept rendering (Burrow Mole or Nib): WebP with JPEG fallback, responsive
   srcset, real width/height and one compact, honest caption.
   The images carry their own on-image labels, so they are never cropped or overlaid:
   they keep their intrinsic aspect ratio. */
import { CONCEPT_LABEL, conceptImage, type ConceptCharacter, type ConceptRole } from '../data/concept';
import { translator, type Locale } from '../i18n/translate';

interface Props {
  locale: Locale;
  role: ConceptRole;
  /** Which character's manifest to use (default: Burrow Mole). */
  character?: ConceptCharacter;
  /** `sizes` attribute describing the rendered width. */
  sizes: string;
  /** Short visible label, e.g. "Front" or "Face close-up". */
  label?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** Add a link to the largest JPEG derivative (for detailed sheets). */
  fullSizeLink?: boolean;
}
const { locale, role, character = 'burrow-mole', sizes, label, loading = 'lazy', fetchpriority, class: className, fullSizeLink = false } = Astro.props;
const t = translator(locale);
const img = conceptImage(role, character);
const hasSlot = Astro.slots.has('default');
---
<figure class:list={['concept-figure', className]}>
  <picture>
    <source type="image/webp" srcset={img.webpSrcset} sizes={sizes} />
    <img src={img.src} srcset={img.jpgSrcset} sizes={sizes} width={img.width} height={img.height} alt={t(img.alt)} loading={loading} decoding={loading === 'eager' ? 'sync' : 'async'} fetchpriority={fetchpriority} />
  </picture>
  <figcaption>
    {label && <strong>{label}</strong>}
    {hasSlot ? <slot /> : <span>{label ? '· ' : ''}{t(CONCEPT_LABEL + '.')}</span>}
    {fullSizeLink && (
      <a href={img.full.href}>{t('Open the full-size sheet')} <span>{`(${img.full.width}\u00a0×\u00a0${img.full.height}\u00a0px JPEG, ${img.full.kb}\u00a0KB)`}</span></a>
    )}
  </figcaption>
</figure>
