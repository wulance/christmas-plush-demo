---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ChoiceFieldset from '../components/ChoiceFieldset.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import { ORG_ID, ROUTES, SITE_NAME, absUrl, absPageUrl, breadcrumbLd, link, url } from '../data/site';
import type { RouteKey } from '../data/site';
import { translator, type Locale } from '../i18n/translate';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translator(locale);

const route: RouteKey = 'christmas';

const jsonLd = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: SITE_NAME,
    url: absUrl(),
    logo: absUrl('assets/logo.png'),
  },
  breadcrumbLd(t('Christmas Plush'), route, locale, t('Home'), t('Collections')),
  {
    '@type': 'Product',
    name: t("Plush Christmas Tree Advent Calendar with 24 Ornaments"),
    description: t("A soft plush Christmas tree with 24 removable plush ornaments, one for each day of December."),
    image: absUrl('assets/tree-calendar.png'),
    brand: { '@id': ORG_ID },
    sku: 'XM-TREE-24',
    offers: { '@type': 'Offer', price: '69.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: absPageUrl('christmas', locale) + '#tree-calendar' },
  },
  {
    '@type': 'Product',
    name: t("Personalized Reindeer Plush with Embroidered Name"),
    description: t("A reindeer plush you design yourself: choose fur, scarf, nose and accessory, and add an embroidered name."),
    image: absUrl('assets/reindeer.png'),
    brand: { '@id': ORG_ID },
    sku: 'XM-DEER',
    offers: { '@type': 'AggregateOffer', lowPrice: '29.00', highPrice: '70.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
];

const STEPS = [
  {
    title: t("1. Sketch"),
    text: t("Our designers sketch the character and agree its personality, proportions and colors with you."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><rect x=\"10\" y=\"6\" width=\"100\" height=\"78\" rx=\"6\" fill=\"#fff\" stroke=\"#e2d8c8\" stroke-width=\"2\"/><circle cx=\"60\" cy=\"44\" r=\"22\" fill=\"none\" stroke=\"#7a6f62\" stroke-width=\"2\" stroke-dasharray=\"5 3\"/><path d=\"M48 24 L40 10 M72 24 L80 10 M44 16 L36 16 M76 16 L84 16\" stroke=\"#7a6f62\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"52\" cy=\"40\" r=\"2.5\" fill=\"#7a6f62\"/><circle cx=\"68\" cy=\"40\" r=\"2.5\" fill=\"#7a6f62\"/><path d=\"M92 70 L104 58\" stroke=\"#e0a83a\" stroke-width=\"5\" stroke-linecap=\"round\"/></svg>",
  },
  {
    title: t("2. Pattern"),
    text: t("The sketch becomes a sewing pattern. We test the shape in calico so the 3D form matches the drawing."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><path d=\"M18 20 Q40 6 58 22 L50 70 Q30 76 18 64 Z\" fill=\"#fbe8d0\" stroke=\"#c4874f\" stroke-width=\"2\"/><path d=\"M12 16 Q40 0 64 18 L56 76 Q28 84 12 68 Z\" fill=\"none\" stroke=\"#c4874f\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/><rect x=\"70\" y=\"18\" width=\"34\" height=\"52\" rx=\"16\" fill=\"#fbe8d0\" stroke=\"#c4874f\" stroke-width=\"2\"/><rect x=\"65\" y=\"13\" width=\"44\" height=\"62\" rx=\"20\" fill=\"none\" stroke=\"#c4874f\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/></svg>",
  },
  {
    title: t("3. Fabric & sample"),
    text: t("We choose the fabric, match the colors and make a sample. You approve photos or a physical sample."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><rect x=\"14\" y=\"20\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#c8323a\" transform=\"rotate(-8 34 46)\"/><rect x=\"40\" y=\"16\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#2e7d4f\"/><rect x=\"66\" y=\"20\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#f2ebe0\" stroke=\"#e2d8c8\" stroke-width=\"2\" transform=\"rotate(8 86 46)\"/><path d=\"M30 82 Q60 60 96 80\" fill=\"none\" stroke=\"#e0a83a\" stroke-width=\"2\" stroke-dasharray=\"4 3\"/></svg>",
  },
  {
    title: t("4. Production & QC"),
    text: t("We sew, stuff, safety-test and inspect every piece, then pack it as a gift. This usually takes 15–25 days after you approve the sample."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><path d=\"M60 8 L92 70 Q60 80 28 70 Z\" fill=\"#46a36d\" stroke=\"#2f7d4f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"53\" y=\"72\" width=\"14\" height=\"12\" rx=\"3\" fill=\"#8b5a3c\"/><circle cx=\"52\" cy=\"48\" r=\"3\" fill=\"#1b2b22\"/><circle cx=\"68\" cy=\"48\" r=\"3\" fill=\"#1b2b22\"/><path d=\"M54 56 Q60 61 66 56\" stroke=\"#1b2b22\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"46\" cy=\"64\" r=\"4\" fill=\"#c8323a\"/><circle cx=\"76\" cy=\"62\" r=\"4\" fill=\"#f2c14e\"/><circle cx=\"60\" cy=\"8\" r=\"5\" fill=\"#f2c14e\"/></svg>",
  },
];

const FAQ = [
  {
    q: t("Are the plush toys safe for babies and toddlers?"),
    a: t("Every design is tested to EN71 (EU/UK), ASTM F963 and CPSIA (US). We embroider eyes instead of using hard plastic parts, and we can supply test reports on request. (Placeholder: replace with your real certifications.)"),
  },
  {
    q: t("How do the ornaments attach to the tree?"),
    a: t("Each ornament has a soft hook-and-loop patch on the back. The tree has hidden patches that toddlers can use, and nothing on it is sharp."),
  },
  {
    q: t("Can I order a reindeer with my company logo?"),
    a: t("Yes. Company orders start at 50 pieces. Use the reindeer builder with \"This is for my company\" ticked, then request a quote and we'll send a free digital proof."),
  },
  {
    q: t("Do you ship internationally?"),
    a: t("Yes, we ship to the US, UK, EU, Canada, Australia, Japan and more. The shipping section above shows the Christmas deadline for each country."),
  },
  {
    q: t("Can you turn a photo into a plush?"),
    a: locale === 'zh'
      ? `可以。我们的<a href="${link('photo', route, locale)}">照片生成玩偶服务</a>可以把人物或宠物做成卡通玩偶，也可以选择节日圣诞帽或毛衣。`
      : `Yes. Our <a href="${link('photo', route, locale)}">photo-to-plush service</a> turns a person or pet into a cartoon plush character, and you can choose a festive Santa hat or sweater for Christmas.`,
  },
];
---
<BaseLayout
  locale={locale}
  route={route}
  title={t("Christmas Plush Toys: Tree Advent Calendar & Personalized Reindeer | Snugglecraft")}
  description={t("Christmas plush toys designed in-house: a plush Christmas tree advent calendar with 24 ornaments, personalized reindeer with embroidered names, and custom branded Christmas plush for companies. Ships worldwide.")}
  ogTitle="Christmas Plush: Tree Advent Calendar & Personalized Reindeer"
  ogDescription="Decorate a plush Christmas tree with 24 ornaments, design your own reindeer, or order branded plush for your company."
  ogImage="assets/christmas-hero.png"
  notice={t("Prototype: brand name, prices, shipping dates and certifications are placeholders. Nothing is charged or sent.")}
  footerNote={t("All names, prices and dates are placeholders.")}
  jsonLd={jsonLd}
>
  <button slot="header-tools" class="icon-btn" id="snow-toggle" type="button" aria-pressed="true" title="Turn snow on or off">❄<span class="sr">{t("Snow effect")}</span></button>
  <!-- HERO -->
  <section class="hero" id="top">
    <canvas id="snow" aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <Breadcrumbs route={route} locale={locale} label={t("Christmas")} />
        <p class="eyebrow light">{t("The Christmas Collection")}</p>
        <h1>{t("Christmas plush toys, designed by us and personalized by you")}</h1>
        <p class="lead">{t("Decorate a plush Christmas tree advent calendar with 24 ornaments, dress a reindeer with a name embroidered on its scarf, or give your team a plush gift in your company colors.")}</p>
        <div class="cta-row">
          <a class="btn btn-gold squish" href="#tree-calendar">{t("Decorate the tree")}</a>
          <a class="btn btn-ghost squish" href="#reindeer">{t("Design a reindeer")}</a>
        </div>
        <p class="hero-deadline" id="hero-deadline" aria-live="polite"></p>
        <nav class="subnav" aria-label={t("On this page")}><a href="#tree-calendar">{t("Tree calendar")}</a><a href="#reindeer">{t("Reindeer")}</a><a href="#advent">{t("Advent doors")}</a><a href="#shipping">{t("Shipping")}</a><a href="#faq">{t("FAQ")}</a></nav>
      </div>
      <div class="hero-art squish">
        <img src={url('assets/christmas-hero.svg')} width="560" height="440" alt={t("A smiling plush Christmas tree with ornaments next to a plush reindeer wearing a red scarf and Santa hat")}>
      </div>
    </div>
  </section>

  <ul class="trust wrap" aria-label={t("Why shop with us")}>
    <li><strong>{t("Designed in-house")}</strong><span>{t("Every pattern is drawn by our own design team")}</span></li>
    <li><strong>{t("Safety tested")}</strong><span>{t("EN71 · ASTM F963 · CPSIA (placeholder)")}</span></li>
    <li><strong>{t("Ships worldwide")}</strong><span>{t("Holiday deadlines for each country")}</span></li>
    <li><strong>{t("Company orders")}</strong><span>{locale === 'zh' ? <>品牌玩偶演示起订 50 件 · <a href={link('corporate', route, locale)}>了解企业定制</a></> : <>Branded plush from 50 pieces · <a href={link('corporate', route, locale)}>details</a></>}</span></li>
  </ul>

  <!-- TREE CALENDAR -->
  <section class="section" id="tree-calendar" aria-labelledby="tree-h">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">{t("Product 1 · $69")}</p>
        <h2 id="tree-h">{t("Decorate the plush Christmas tree advent calendar")}</h2>
        <p>{t("The calendar is a soft, smiling tree with 24 plush ornaments that attach with hidden Velcro, one for each day of December. Choose which ornaments go in your set: drag them onto the tree or tap one to add it. Drag an ornament off the tree to remove it.")}</p>
        <div class="palette" id="orn-palette" aria-label={t("Ornaments")}></div>
        <div class="progress-row">
          <div class="progress" aria-hidden="true"><div id="tree-progress"></div></div>
          <span><strong id="tree-count">0</strong> / 24 days</span>
        </div>
        <p class="hint" id="tree-hint" aria-live="polite"></p>
        <div class="btn-row">
          <button class="btn btn-red squish" id="tree-add" type="button" disabled>{t("Add calendar set to cart · $69")}</button>
          <button class="btn btn-line" id="tree-fill" type="button">{t("Fill the rest for me")}</button>
          <button class="btn btn-text" id="tree-reset" type="button">{t("Start over")}</button>
        </div>
      </div>
      <div class="tree-wrap">
        <div class="tree-stage" id="tree-stage">
          <svg id="tree-svg" viewBox="0 0 300 380" role="img" aria-labelledby="tree-svg-t">
            <title id="tree-svg-t">{t("Plush Christmas tree. Drop ornaments on it.")}</title>
            <ellipse cx="150" cy="356" rx="110" ry="12" fill="#000" opacity=".08"/>
            <rect x="128" y="296" width="44" height="52" rx="10" fill="#8b5a3c"/>
            <path d="M136 304 V340 M150 304 V340 M164 304 V340" stroke="#a9734f" stroke-width="2" stroke-dasharray="4 4"/>
            <g class="tier">
              <path d="M150 138 L268 300 Q150 324 32 300 Z" fill="#2f7d4f" stroke="#235f3c" stroke-width="4" stroke-linejoin="round"/>
              <path d="M150 152 L254 296 Q150 316 46 296 Z" fill="none" stroke="#dff1e5" stroke-width="1.6" stroke-dasharray="6 5" opacity=".55"/>
              <path d="M150 80 L236 222 Q150 242 64 222 Z" fill="#3a9160" stroke="#2a6f47" stroke-width="4" stroke-linejoin="round"/>
              <path d="M150 94 L223 218 Q150 235 77 218 Z" fill="none" stroke="#dff1e5" stroke-width="1.6" stroke-dasharray="6 5" opacity=".55"/>
              <path d="M150 22 L206 144 Q150 160 94 144 Z" fill="#46a36d" stroke="#2f7d4f" stroke-width="4" stroke-linejoin="round"/>
              <path d="M150 38 L195 139 Q150 152 105 139 Z" fill="none" stroke="#dff1e5" stroke-width="1.6" stroke-dasharray="6 5" opacity=".55"/>
            </g>
            <g class="tree-face">
              <circle cx="130" cy="190" r="6" fill="#1b2b22"/><circle cx="132" cy="188" r="2" fill="#fff"/>
              <circle cx="170" cy="190" r="6" fill="#1b2b22"/><circle cx="172" cy="188" r="2" fill="#fff"/>
              <path d="M140 203 Q150 212 160 203" fill="none" stroke="#1b2b22" stroke-width="3" stroke-linecap="round"/>
              <ellipse cx="117" cy="204" rx="8" ry="5" fill="#f2a0a8" opacity=".6"/>
              <ellipse cx="183" cy="204" rx="8" ry="5" fill="#f2a0a8" opacity=".6"/>
            </g>
          </svg>
          <div class="tree-layer" id="tree-layer"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- REINDEER BUILDER -->
  <section class="section alt" id="reindeer" aria-labelledby="deer-h">
    <div class="wrap two-col reverse">
      <div class="deer-preview">
        <div class="deer-card squish">
          <svg id="deer" viewBox="0 0 300 340" role="img" aria-labelledby="deer-t">
            <title id="deer-t">{t("Preview of your personalized reindeer plush")}</title>
            <defs><path id="scarf-mid" d="M88 189 Q150 217 212 189"/></defs>
            <g id="d-antlers" fill="none" stroke="#f0d7b0" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M120 74 C110 52 102 38 94 20"/><path d="M106 46 C94 42 82 44 72 36"/>
              <path d="M180 74 C190 52 198 38 206 20"/><path d="M194 46 C206 42 218 44 228 36"/>
            </g>
            <g class="outline">
              <ellipse class="d-body" cx="78" cy="98" rx="27" ry="13" transform="rotate(-25 78 98)"/>
              <ellipse class="d-body" cx="222" cy="98" rx="27" ry="13" transform="rotate(25 222 98)"/>
            </g>
            <ellipse class="d-muzzle" cx="80" cy="98" rx="14" ry="6" transform="rotate(-25 80 98)"/>
            <ellipse class="d-muzzle" cx="220" cy="98" rx="14" ry="6" transform="rotate(25 220 98)"/>
            <g class="outline">
              <ellipse class="d-body" cx="86" cy="252" rx="18" ry="34" transform="rotate(22 86 252)"/>
              <ellipse class="d-body" cx="214" cy="252" rx="18" ry="34" transform="rotate(-22 214 252)"/>
              <ellipse class="d-body" cx="150" cy="262" rx="72" ry="66"/>
            </g>
            <ellipse class="d-muzzle" cx="150" cy="274" rx="42" ry="40"/>
            <g class="outline">
              <ellipse class="d-body" cx="112" cy="320" rx="28" ry="16"/>
              <ellipse class="d-body" cx="188" cy="320" rx="28" ry="16"/>
            </g>
            <ellipse class="d-hoof" cx="112" cy="325" rx="16" ry="8"/>
            <ellipse class="d-hoof" cx="188" cy="325" rx="16" ry="8"/>
            <g id="d-scarf-g">
              <path class="d-scarf" d="M174 190 L204 192 L200 254 L172 250 Z"/>
              <path d="M174 246 L200 250" stroke="#fff" stroke-width="2" stroke-dasharray="3 3" opacity=".6"/>
              <path class="d-scarf" d="M84 176 Q150 204 216 176 L220 199 Q150 229 80 199 Z"/>
              <path d="M86 182 Q150 210 214 182 M83 195 Q150 223 217 195" fill="none" stroke="#fff" stroke-width="1.5" stroke-dasharray="4 4" opacity=".5"/>
              <text id="d-name" font-weight="800" letter-spacing="1" font-family="ui-rounded, 'Nunito', 'Segoe UI', system-ui, sans-serif"><textPath href="#scarf-mid" startOffset="50%" text-anchor="middle" dominant-baseline="middle" id="d-name-tp"></textPath></text>
            </g>
            <g id="acc-bell">
              <path d="M150 214 C141 214 140 222 140 227 L138 234 L162 234 L160 227 C160 222 159 214 150 214 Z" fill="#e0a83a" stroke="#b9862a" stroke-width="1.5"/>
              <circle cx="150" cy="236" r="3.5" fill="#8a5a1a"/>
            </g>
            <g class="outline"><ellipse class="d-body" cx="150" cy="122" rx="72" ry="62"/></g>
            <ellipse class="d-muzzle" cx="150" cy="153" rx="40" ry="27"/>
            <ellipse id="d-nose" cx="150" cy="141" rx="14" ry="10" fill="#2b2220"/>
            <ellipse cx="145" cy="138" rx="4" ry="2.4" fill="#fff" opacity=".5"/>
            <path d="M140 160 Q150 168 160 160" fill="none" stroke="#3a2a22" stroke-width="3" stroke-linecap="round"/>
            <circle cx="122" cy="113" r="7" fill="#2b2220"/><circle cx="124.5" cy="110.5" r="2.4" fill="#fff"/>
            <circle cx="178" cy="113" r="7" fill="#2b2220"/><circle cx="180.5" cy="110.5" r="2.4" fill="#fff"/>
            <ellipse cx="104" cy="139" rx="10" ry="6" fill="#f2a0a8" opacity=".55"/>
            <ellipse cx="196" cy="139" rx="10" ry="6" fill="#f2a0a8" opacity=".55"/>
            <g id="acc-hat">
              <path d="M118 72 C122 40 150 24 186 28 C196 30 202 38 200 46 C192 44 184 50 182 72 Z" fill="#c8323a" stroke="#a3262d" stroke-width="2"/>
              <rect x="110" y="60" width="80" height="17" rx="8.5" fill="#fffaf2" stroke="#e7ddd0" stroke-width="2"/>
              <circle cx="201" cy="46" r="9" fill="#fffaf2" stroke="#e7ddd0" stroke-width="2"/>
            </g>
            <g id="acc-earmuffs">
              <path d="M78 92 Q150 18 222 92" fill="none" class="d-scarf-stroke" stroke-width="8" stroke-linecap="round"/>
              <circle cx="76" cy="98" r="18" fill="#fffaf2" stroke="#e7ddd0" stroke-width="2"/>
              <circle cx="224" cy="98" r="18" fill="#fffaf2" stroke="#e7ddd0" stroke-width="2"/>
            </g>
          </svg>
        </div>
        <p class="deer-summary" id="deer-summary" aria-live="polite"></p>
      </div>
      <div>
        <p class="eyebrow">{t("Product 2 · from $29")}</p>
        <h2 id="deer-h">{t("Design your personalized reindeer plush")}</h2>
        <p>{t("Choose the fur, scarf, nose and accessory, then add a name, which we embroider in thread on the scarf. The preview updates as you choose.")}</p>
        <form id="deer-form" class="builder" autocomplete="off">
          <ChoiceFieldset legend={t("Fur")} name="body" kind="swatch" options={[
            { value: 'cocoa', label: t("Cocoa"), color: '#8a5a3b' },
            { value: 'caramel', label: t("Caramel"), color: '#c4874f' },
            { value: 'snow', label: t("Snow"), color: '#f2ebe0' },
            { value: 'grey', label: t("Frost grey"), color: '#9b9ca6' },
          ]} />
          <ChoiceFieldset legend={t("Scarf")} name="scarf" kind="swatch" options={[
            { value: 'berry', label: t("Berry"), color: '#c8323a' },
            { value: 'pine', label: t("Pine"), color: '#2e7d4f' },
            { value: 'navy', label: t("Navy"), color: '#263a6b' },
            { value: 'gold', label: t("Gold"), color: '#d9a33a' },
          ]}
            custom={{ label: t("Custom"), name: 'custom', value: '#7b3fa0', ariaLabel: t("Custom scarf color") }} />
          <ChoiceFieldset legend={t("Nose")} name="nose" kind="swatch" options={[
            { value: 'black', label: t("Black"), color: '#2b2220' },
            { value: 'cocoa', label: t("Cocoa"), color: '#6b4330' },
            { value: 'rose', label: t("Rose"), color: '#e48a9a' },
            { value: 'berry', label: t("Berry"), color: '#c8323a' },
          ]} />
          <ChoiceFieldset legend={t("Accessory")} name="acc" kind="pill" options={[
            { value: 'none', label: t("None") },
            { value: 'hat', label: t("Santa hat +$4") },
            { value: 'earmuffs', label: t("Earmuffs +$4") },
            { value: 'bell', label: t("Jingle bell +$3") },
          ]} />
          <ChoiceFieldset legend={t("Size")} name="size" kind="pill" options={[
            { value: 'S', label: '20 cm · $29' },
            { value: 'M', label: '30 cm · $39' },
            { value: 'L', label: '45 cm · $59' },
          ]} />
          <div class="field personal-only">
            <label for="d-name-in">{t("Embroidered name (+$5)")}</label>
            <input id="d-name-in" name="name" type="text" maxlength="12" placeholder="e.g. Mia">
          </div>
          <label class="check"><input type="checkbox" name="corp"> {t("This is for my company (logo or brand name on the scarf)")}</label>
          <div class="field corp-only">
            <label for="d-logo-in">{t("Company or brand name on the scarf")}</label>
            <input id="d-logo-in" name="logo" type="text" maxlength="16" placeholder="e.g. ACME">
            <p class="small">{t("Company orders start at 50 pieces. In production we embroider your real logo, matched to your brand colors (choose a Custom scarf color above).")}</p>
          </div>
          <div class="price-row">
            <span class="price" id="deer-price">$39</span>
            <button class="btn btn-red squish" id="deer-cta" type="button">{t("Add to cart")}</button>
            <button class="btn btn-line" id="deer-share" type="button">{t("Copy share link")}</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ONLINE ADVENT CALENDAR -->
  <section class="section advent-section" id="advent" aria-labelledby="advent-h">
    <div class="wrap">
      <p class="eyebrow">{t("Open one door a day, Dec 1–24")}</p>
      <h2 id="advent-h">{t("Our online advent calendar")}</h2>
      <p class="center-text">{t("One door opens each day in December. Behind it you'll find a design sketch, a story from the workshop, or a gift code. Come back each day to open the next one.")}</p>
      <label class="check center"><input type="checkbox" id="advent-preview"> Preview all doors (demo only)</label>
      <div class="advent-grid" id="advent-grid"></div>
      <div class="advent-panel" id="advent-panel" aria-live="polite" hidden></div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section alt" id="process" aria-labelledby="process-h">
    <div class="wrap">
      <p class="eyebrow">{t("How we work")}</p>
      <h2 id="process-h">{t("From sketch to plush")}</h2>
      <Timeline steps={STEPS} />
    </div>
  </section>

  <!-- CORPORATE -->
  <section class="section" id="corporate" aria-labelledby="corp-h">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">{t("For companies")}</p>
        <h2 id="corp-h">{t("Custom Christmas plush for your company")}</h2>
        <p>{locale === 'zh' ? <>把绣有公司 logo、采用品牌色的麋鹿或圣诞树送给员工和客户。如果想根据 logo 和公司文化做吉祥物，请查看我们的<a href={link('corporate', route, locale)}>企业定制玩偶</a>服务。</> : <>Send employees and clients a reindeer or tree with your logo embroidered on it, in your exact brand colors. Want a mascot based on your logo and company culture? See our <a href={link('corporate', route, locale)}>corporate custom plush</a> service.</>}</p>
        <ul class="ticks">
          <li>{t("Orders start at 50 pieces, and we send a free digital design proof")}</li>
          <li>{t("Pantone color matching, plus woven or embroidered labels")}</li>
          <li>{t("Branded gift boxes, and delivery to several addresses")}</li>
          <li>{t("Plan 6–8 weeks for Christmas delivery, or order early for 2027")}</li>
