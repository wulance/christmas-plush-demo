---
/* Studio: design capability. The original-concept portfolio (Burrow Mole v0.4 and
   Nib the owlet v0.2, both 3D concepts with no physical sample), the full process,
   the sketch-to-colour slider and what the studio does. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import ConceptFigure from '../components/ConceptFigure.astro';
import { conceptImage } from '../data/concept';
import { ORG_ID, SITE_NAME, absUrl, absPageUrl, link, type RouteKey } from '../data/site';
import { translator, type Locale } from '../i18n/translate';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translator(locale);

const route: RouteKey = 'studio';
const sheet = conceptImage('turnaround');
const nibSheet = conceptImage('turnaround', 'nib');

const jsonLd = [
  {
    '@type': 'WebPage',
    name: t("Snugglecraft design studio"),
    url: absPageUrl('studio', locale),
    isPartOf: { '@type': 'WebSite', '@id': absUrl('#website') },
    publisher: { '@type': 'Organization', '@id': ORG_ID, name: SITE_NAME },
    inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t("Home"), item: absPageUrl('home', locale) },
      { '@type': 'ListItem', position: 2, name: t("Studio"), item: absPageUrl('studio', locale) },
    ],
  },
];

const STEPS = [
  {
    title: t("1. Sketch"),
    text: t("We sketch the character and agree its personality, proportions and colors with you."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><rect x=\"10\" y=\"6\" width=\"100\" height=\"78\" rx=\"6\" fill=\"#fff\" stroke=\"#e2d8c8\" stroke-width=\"2\"/><circle cx=\"60\" cy=\"44\" r=\"22\" fill=\"none\" stroke=\"#7a6f62\" stroke-width=\"2\" stroke-dasharray=\"5 3\"/><circle cx=\"44\" cy=\"22\" r=\"7\" fill=\"none\" stroke=\"#7a6f62\" stroke-width=\"2\"/><circle cx=\"76\" cy=\"22\" r=\"7\" fill=\"none\" stroke=\"#7a6f62\" stroke-width=\"2\"/><circle cx=\"52\" cy=\"40\" r=\"2.5\" fill=\"#7a6f62\"/><circle cx=\"68\" cy=\"40\" r=\"2.5\" fill=\"#7a6f62\"/><path d=\"M92 70 L104 58\" stroke=\"#e0a83a\" stroke-width=\"5\" stroke-linecap=\"round\"/></svg>",
  },
  {
    title: t("2. Pattern"),
    text: t("The sketch becomes a sewing pattern, and we test the 3D shape in calico."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><path d=\"M18 20 Q40 6 58 22 L50 70 Q30 76 18 64 Z\" fill=\"#fbe8d0\" stroke=\"#c4874f\" stroke-width=\"2\"/><path d=\"M12 16 Q40 0 64 18 L56 76 Q28 84 12 68 Z\" fill=\"none\" stroke=\"#c4874f\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/><rect x=\"70\" y=\"18\" width=\"34\" height=\"52\" rx=\"16\" fill=\"#fbe8d0\" stroke=\"#c4874f\" stroke-width=\"2\"/><rect x=\"65\" y=\"13\" width=\"44\" height=\"62\" rx=\"20\" fill=\"none\" stroke=\"#c4874f\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/></svg>",
  },
  {
    title: t("3. Fabric & sample"),
    text: t("We choose the fabric, match the colors and sew a sample for you to approve."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><rect x=\"14\" y=\"20\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#9fd8c4\" transform=\"rotate(-8 34 46)\"/><rect x=\"40\" y=\"16\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#3b7dd8\"/><rect x=\"66\" y=\"20\" width=\"40\" height=\"52\" rx=\"4\" fill=\"#f2ebe0\" stroke=\"#e2d8c8\" stroke-width=\"2\" transform=\"rotate(8 86 46)\"/><path d=\"M30 82 Q60 60 96 80\" fill=\"none\" stroke=\"#e0a83a\" stroke-width=\"2\" stroke-dasharray=\"4 3\"/></svg>",
  },
  {
    title: t("4. Production & QC"),
    text: t("We sew, stuff, safety-test and inspect every piece. This usually takes 15–25 days after you approve the sample."),
    svg: "<svg viewBox=\"0 0 120 90\" aria-hidden=\"true\"><circle cx=\"40\" cy=\"22\" r=\"10\" fill=\"#9fd8c4\"/><circle cx=\"80\" cy=\"22\" r=\"10\" fill=\"#9fd8c4\"/><ellipse cx=\"60\" cy=\"50\" rx=\"36\" ry=\"32\" fill=\"#9fd8c4\"/><ellipse cx=\"60\" cy=\"66\" rx=\"18\" ry=\"11\" fill=\"#fff4e6\"/><circle cx=\"48\" cy=\"44\" r=\"3.5\" fill=\"#1b2b22\"/><circle cx=\"72\" cy=\"44\" r=\"3.5\" fill=\"#1b2b22\"/><path d=\"M54 54 Q60 59 66 54\" stroke=\"#1b2b22\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M92 74 L100 82 L114 64\" fill=\"none\" stroke=\"#2f7d4f\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
  },
];

const NOTES = [
  [t("Face"), t("Closed crescent eyes and a small “w” mouth in flat satin stitch, with the pile trimmed around the stitching. No hard parts.")],
  [t("Flower nose"), t("A ring of rose felt petals on a corduroy snout that tilts slightly down.")],
  [t("Spade paws"), t("Flat two-layer corduroy with rounded fingertips and a topstitched palm line.")],
  [t("Silhouette"), t("A low pear-shaped dome with four seams meeting at the crown, on a flat felt base.")],
  [t("Size targets"), t("About 24 cm tall and 30 cm wide, measured on the 3D model. Not verified on a sample.")],
];

const NIB_NOTES = [
  [t("Silhouette"), t("A dusty-blue, chubby owlet with a cream heart-shaped face, little tufts, a small soft beak and wings held out as if for a hug.")],
  [t("Eyes"), t("Matte satin-stitched oval eye fills with white stitched highlights, not glossy hard eyes.")],
  [t("Feet"), t("One-piece mustard felt feet with three toes. The stitches sit in the valleys between the toes.")],
  [t("Size targets"), t("23.2 cm tall × 23.7 cm wide (wing tip to wing tip) × 19.0 cm deep. These are model targets pending sampling; the turnaround sheet shows them rounded.")],
];

const CONCEPTS = [
  { id: 'burrow-mole', character: 'burrow-mole' as const, name: t("Burrow Mole"), version: t("Option A · concept v0.4"),
    text: t("A low, pear-shaped mole with a flower nose and spade paws, refined at checkpoint v0.4.") },
  { id: 'nib', character: 'nib' as const, name: t("Nib the owlet"), version: t("Concept v0.2"),
    text: t("A chubby dusty-blue owlet with a heart-shaped face, stitched eyes and felt feet.") },
];

const CAPABILITIES = [
  [t("Character design"), t("We design from your logo, brief or photo.")],
  [t("Pattern making"), t("We draft the pattern and test it in calico.")],
  [t("Color matching"), t("We match fabric and thread to your Pantone colors.")],
  [t("Safety testing"), t("EN71 · ASTM F963 · CPSIA (placeholder, not verified).")],
];
---
<BaseLayout
  locale={locale}
  route={route}
  title={t("Our Plush Design Studio: Original Characters, Patterns & Process | Snugglecraft")}
  description={t("How Snugglecraft designs plush in-house: our original characters Burrow Mole and Nib the owlet shown as 3D concept renderings, the sketch-to-production process and what the studio does.")}
  ogTitle={t("Inside the Snugglecraft design studio")}
  ogDescription={t("Our original plush characters, Burrow Mole (v0.4) and Nib the owlet (v0.2), shown as 3D concepts, and how we take any plush from sketch to production.")}
  ogImage="assets/concept/burrow-mole-v04-turnaround-1200.jpg"
  ogImageAlt={t("Front, side and back 3D concept turnaround of Burrow Mole (option A, v0.4). Not a photograph of a manufactured sample.")}
  ogImageSize={[1200, 613]}
  notice={t("Prototype site: Burrow Mole and Nib images are 3D concept renderings, not photos of manufactured samples. Certifications are placeholders.")}
  jsonLd={jsonLd}
>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label={t("Breadcrumb")}><a href={link('home', route, locale)}>{t("Home")}</a> › <span>{t("Studio")}</span></nav>
      <h1>{t("How we design an original plush")}</h1>
      <p class="lead">{t("Every character is drawn, patterned and checked by our own team. Below are two of our original concepts, followed by the steps any plush goes through with us.")}</p>
      <nav class="page-toc" aria-label={t("On this page")}><a href="#concepts">{t("Original concepts")}</a><a href="#burrow-mole">{t("Burrow Mole")}</a><a href="#nib">{t("Nib")}</a><a href="#process">{t("Process")}</a><a href="#capabilities">{t("What we do")}</a></nav>
    </div>
  </header>

  <!-- Original concepts: the studio's own characters, presented equally -->
  <section class="section" id="concepts" aria-labelledby="concepts-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="concepts-h">{t("Original concepts")}</h2>
        <p>{t("Characters we design for ourselves, not customer projects. All images are 3D concept renderings; no physical sample of either character has been made.")}</p>
      </div>
      <ul class="concept-cards">
        {CONCEPTS.map(c => (
          <li class="concept-card">
            <ConceptFigure locale={locale} role="hero" character={c.character} sizes="(min-width: 1180px) 548px, (min-width: 760px) calc(50vw - 32px), calc(100vw - 40px)">
              <span>{c.name} · {t("3D concept rendering, not a photograph of a manufactured sample.")}</span>
            </ConceptFigure>
            <p class="concept-version">{c.version}</p>
            <h3><a href={'#' + c.id}>{c.name}</a></h3>
            <p>{c.text}</p>
            <span class="concept-more" aria-hidden="true">{t("See all views ↓")}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Burrow Mole: original concept, technical views -->
  <section class="section section-tint" id="burrow-mole" aria-labelledby="mole-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="mole-h">{t("Burrow Mole, our original concept")}</h2>
        <p>{t("Our own character, not a customer project. These are 3D concept renderings from design checkpoint v0.4 (option A). No physical sample has been made yet.")}</p>
      </div>

      <!-- Wide screens: the full sheet. Narrow screens: the same views stacked (the sheet's notes would be unreadable). -->
      <ConceptFigure locale={locale} role="turnaround" class="sheet-wide" sizes="(min-width: 1180px) 1120px, calc(100vw - 40px)" fullSizeLink>
        <span><strong>{t("Front, side and back turnaround")}</strong> · {t("3D concept rendering, not a photograph of a manufactured sample. Sizes are targets measured on the 3D model.")}</span>
      </ConceptFigure>
      <div class="views-narrow">
        <ConceptFigure locale={locale} role="front" label={t("Front")} sizes="calc(100vw - 40px)" />
        <ConceptFigure locale={locale} role="side" label={t("Side")} sizes="calc(100vw - 40px)" />
        <ConceptFigure locale={locale} role="back" label={t("Back")} sizes="calc(100vw - 40px)" />
        <p class="small"><a href={sheet.full.href}>{t("Open the full turnaround sheet with notes")}</a> ({sheet.full.width} × {sheet.full.height} px JPEG)</p>
      </div>

      <div class="split concept-detail">
        <ConceptFigure locale={locale} role="face-closeup" label={t("Face close-up")} sizes="(min-width: 1180px) 560px, (min-width: 900px) 48vw, calc(100vw - 40px)" />
        <div>
          <h3>{t("What checkpoint v0.4 shows")}</h3>
          <dl class="notes">
            {NOTES.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Nib the owlet: original concept v0.2, technical views (same pattern as Burrow Mole) -->
  <section class="section" id="nib" aria-labelledby="nib-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="nib-h">{t("Nib the owlet, our original concept")}</h2>
        <p>{t("Our own character, not a customer project. These are 3D concept renderings of concept version 0.2, dated 17 November 2026. No physical sample has been made.")}</p>
      </div>

      <ConceptFigure locale={locale} role="turnaround" character="nib" class="sheet-wide" sizes="(min-width: 1180px) 1120px, calc(100vw - 40px)" fullSizeLink>
        <span><strong>{t("Front, side and back turnaround")}</strong> · {t("3D concept rendering, not a photograph of a manufactured sample. Measurements on the sheet are rounded model targets, pending sampling.")}</span>
      </ConceptFigure>
      <div class="views-narrow">
        <ConceptFigure locale={locale} role="front" character="nib" label={t("Front")} class="view-square" sizes="(max-width: 479px) calc(100vw - 40px), 440px" />
        <ConceptFigure locale={locale} role="side" character="nib" label={t("Side")} class="view-square" sizes="(max-width: 479px) calc(100vw - 40px), 440px" />
        <ConceptFigure locale={locale} role="back" character="nib" label={t("Back")} class="view-square" sizes="(max-width: 479px) calc(100vw - 40px), 440px" />
        <p class="small"><a href={nibSheet.full.href}>{t("Open the full turnaround sheet with notes")}</a> ({nibSheet.full.width} × {nibSheet.full.height} px JPEG)</p>
      </div>

      <div class="concept-detail concept-detail-wide">
        <ConceptFigure locale={locale} role="face-feet-detail" character="nib" label={t("Face and feet detail")} sizes="(min-width: 1180px) 1120px, calc(100vw - 40px)" fullSizeLink />
        <div>
          <h3>{t("What concept v0.2 shows")}</h3>
          <dl class="notes notes-grid">
            {NIB_NOTES.map(([title, d]) => <div><dt>{title}</dt><dd>{d}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Process: the sketch slider and the four steps -->
  <section class="section section-tint" id="process" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-h">{t("From sketch to plush in four steps")}</h2>
        <p>{t("Burrow Mole and Nib are both still at the first step. Steps 2–4 describe how any plush continues once a design is approved.")}</p>
      </div>
      <div class="split sketch-compare">
        <div>
          <div class="compare" id="compare" style="--pos:50%">
              <svg viewBox="0 0 320 300" aria-hidden="true">
                  <defs><pattern id="grid" width="16" height="16" patternUnits="userSpaceOnUse"><path d="M16 0 H0 V16" fill="none" stroke="#e8e1d4" stroke-width="1"/></pattern></defs>
                  <rect width="320" height="300" fill="#fffdf8"/><rect width="320" height="300" fill="url(#grid)"/>
                  <g fill="none" stroke="#6d625a" stroke-width="2" stroke-linecap="round">
                    <path d="M160 40 V290 M30 138 H290" stroke="#c9bfb0" stroke-dasharray="6 6" stroke-width="1.5"/>
                    <circle cx="88" cy="78" r="34"/><circle cx="232" cy="78" r="34"/>
                    <circle cx="90" cy="80" r="17" stroke-dasharray="3 3"/><circle cx="230" cy="80" r="17" stroke-dasharray="3 3"/>
                    <ellipse cx="62" cy="200" rx="22" ry="36" transform="rotate(25 62 200)"/>
                    <ellipse cx="258" cy="200" rx="22" ry="36" transform="rotate(-25 258 200)"/>
                    <ellipse cx="118" cy="270" rx="34" ry="20"/><ellipse cx="202" cy="270" rx="34" ry="20"/>
                    <ellipse cx="160" cy="165" rx="112" ry="104"/>
                    <ellipse cx="160" cy="224" rx="62" ry="38"/>
                    <ellipse cx="160" cy="224" rx="56" ry="32" stroke-dasharray="4 4" stroke="#b5a998"/>
                    <path d="M160 244 C140 228 136 212 148 206 C155 202 160 208 160 212 C160 208 165 202 172 206 C184 212 180 228 160 244 Z"/>
                    <circle cx="124" cy="138" r="11"/><circle cx="196" cy="138" r="11"/>
                    <ellipse cx="160" cy="160" rx="9" ry="6"/>
                    <path d="M150 170 Q160 178 170 170"/>
                  </g>
                  <g font-family="'Segoe Print', 'Comic Sans MS', cursive" font-size="11" fill="#8a7f72">
                    <text x="14" y="30">Ears: 2 pcs + pink lining</text>
                    <text x="200" y="128">Embroidered eyes</text>
                    <text x="14" y="252">Belly patch, top-stitched</text>
                    <text x="208" y="296">Momo v3 · 30 cm</text>
                  </g>
                </svg>
                <svg class="plush-layer" viewBox="0 0 320 300" aria-hidden="true">
                  <defs><radialGradient id="soft" cx="50%" cy="45%" r="70%"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#f3e8d6"/></radialGradient></defs>
                  <rect width="320" height="300" fill="url(#soft)"/>
                  <g fill="#9fd8c4" stroke="#7cbfa9" stroke-width="3">
                    <circle cx="88" cy="78" r="34"/><circle cx="232" cy="78" r="34"/>
                    <ellipse cx="62" cy="200" rx="22" ry="36" transform="rotate(25 62 200)"/>
                    <ellipse cx="258" cy="200" rx="22" ry="36" transform="rotate(-25 258 200)"/>
                    <ellipse cx="118" cy="270" rx="34" ry="20"/><ellipse cx="202" cy="270" rx="34" ry="20"/>
                  </g>
                  <circle cx="90" cy="80" r="17" fill="#f7b7a3"/><circle cx="230" cy="80" r="17" fill="#f7b7a3"/>
                  <ellipse cx="160" cy="165" rx="112" ry="104" fill="#9fd8c4" stroke="#7cbfa9" stroke-width="3"/>
                  <ellipse cx="160" cy="224" rx="62" ry="38" fill="#fff4e6"/>
                  <ellipse cx="160" cy="224" rx="56" ry="32" fill="none" stroke="#e6d5bf" stroke-width="2" stroke-dasharray="5 4"/>
                  <path d="M160 244 C140 228 136 212 148 206 C155 202 160 208 160 212 C160 208 165 202 172 206 C184 212 180 228 160 244 Z" fill="#f07a6a"/>
                  <circle cx="124" cy="138" r="11" fill="#1b2b22"/><circle cx="128" cy="134" r="4" fill="#fff"/>
                  <circle cx="196" cy="138" r="11" fill="#1b2b22"/><circle cx="200" cy="134" r="4" fill="#fff"/>
                  <ellipse cx="160" cy="160" rx="9" ry="6" fill="#1b2b22"/>
                  <path d="M150 170 Q160 178 170 170" fill="none" stroke="#1b2b22" stroke-width="3" stroke-linecap="round"/>
                  <ellipse cx="104" cy="166" rx="12" ry="7" fill="#f7a6a6" opacity=".6"/><ellipse cx="216" cy="166" rx="12" ry="7" fill="#f7a6a6" opacity=".6"/>
                </svg>
          
              <div class="divider" aria-hidden="true"></div>
              <input type="range" id="compare-range" min="0" max="100" value="50" aria-label={t("Compare the design sketch of Momo with its colour illustration")} aria-describedby="compare-help">
            </div>
          <div class="compare-labels" aria-hidden="true"><span>{t("Design sketch")}</span><span>{t("Colour illustration")}</span></div>
        </div>
        <div>
          <h3>{t("Every plush starts as a drawing")}</h3>
          <p id="compare-help">{t("Drag the slider, or use the arrow keys, to compare a designer's sketch of Momo, our studio mascot, with its colour illustration. Both are drawings, not product photos.")}</p>
        </div>
      </div>
      <Timeline steps={STEPS} />
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section" id="capabilities" aria-labelledby="cap-h">
    <div class="wrap">
      <div class="section-head"><h2 id="cap-h">{t("What the studio does")}</h2></div>
      <ul class="capabilities">
        {CAPABILITIES.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section closing" aria-labelledby="cta-h">
    <div class="wrap closing-inner">
      <h2 id="cta-h">{t("Want an original character of your own?")}</h2>
      <p>{t("Tell us about your brand, event or idea and we'll reply with a free digital design proposal.")}</p>
      <a class="btn btn-primary" href={link('corporate', route, locale, 'quote')}>{t("Request a quote")}</a>
    </div>
  </section>
  <script>
    import '../scripts/studio.js';
  </script>
</BaseLayout>
