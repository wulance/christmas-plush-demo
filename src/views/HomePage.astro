---
/* Home: one purpose per section.
   1 Hero · 2 Offerings · 3 Studio teaser · 4 FAQ · 5 Closing inquiry.
   Technical concept views, the full process, the sketch slider and capability
   detail live on /studio/. Builders live on their offering pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ConceptFigure from '../components/ConceptFigure.astro';
import { ORG_ID, ROUTES, SITE_NAME, absUrl, absPageUrl, link, url } from '../data/site';
import type { RouteKey } from '../data/site';
import { translator, type Locale } from '../i18n/translate';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translator(locale);

const route: RouteKey = 'home';

const jsonLd = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: SITE_NAME,
    url: absUrl(),
    logo: absUrl('assets/logo.png'),
    description: t("Plush toy design studio: custom company mascots, seasonal collections and photo-to-plush characters."),
  },
  {
    '@type': 'WebSite',
    '@id': absUrl('#website'),
    url: absPageUrl('home', locale),
    name: SITE_NAME,
    publisher: { '@id': ORG_ID },
    inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
  },
  {
    '@type': 'ItemList',
    name: t("Plush offerings"),
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t("Corporate custom plush"), url: absPageUrl('corporate', locale) },
      { '@type': 'ListItem', position: 2, name: t("Seasonal collection"), url: absPageUrl('christmas', locale) },
      { '@type': 'ListItem', position: 3, name: t("Photo to plush"), url: absPageUrl('photo', locale) },
    ],
  },
];

const OFFERINGS = [
  {
    to: 'corporate' as RouteKey,
    kicker: t('For companies'),
    title: t('Corporate custom plush'),
    text: t('Mascots designed from your logo, brand colors and company culture, for employee gifts, events and merchandise.'),
    more: t('Design a mascot'),
    img: { src: 'assets/art-corporate.svg', w: 320, h: 300, alt: t('Illustration: blue mascot plush with a company logo patch on its belly') },
  },
  {
    to: 'christmas' as RouteKey,
    kicker: t('This season: Christmas'),
    title: t('Seasonal collection'),
    text: t('A plush tree advent calendar with 24 ornaments, and reindeer you dress and name yourself.'),
    more: t('See the seasonal collection'),
    img: { src: 'assets/christmas-hero.svg', w: 560, h: 440, alt: t('Illustration: plush Christmas tree advent calendar and a personalized reindeer plush') },
  },
  {
    to: 'photo' as RouteKey,
    kicker: t('Personal gifts'),
    title: t('Photo to plush'),
    text: t('A person or pet, drawn by our illustrators as a cartoon character and sewn as a one-of-a-kind plush.'),
    more: t('Try the style preview'),
    img: { src: 'assets/art-photo.svg', w: 380, h: 300, alt: t('Illustration: a photo of a person turned into a cartoon plush doll') },
  },
];

const STEPS = [
  [t('Sketch'), t('We draw the character and agree its personality and colors with you.')],
  [t('Pattern'), t('The drawing becomes a sewing pattern, tested in calico.')],
  [t('Sample'), t('We match fabric and colors and sew a sample for you to approve.')],
  [t('Production'), t('We sew, check and pack each piece after you approve the sample.')],
];

const FAQ = [
  {
    q: t("What is the minimum order?"),
    a: t("Corporate custom plush starts at 50 pieces. Seasonal and photo-to-plush items can be ordered one at a time."),
  },
  {
    q: t("How long does a custom plush take?"),
    a: t("The first digital design takes 2–3 days and a physical sample takes 7–10 days. Production takes 15–25 days after you approve the sample, plus shipping. (Placeholder timings for this prototype.)"),
  },
  {
    q: t("Are your plush toys safe for children?"),
    a: t("Our designs are tested to EN71, ASTM F963 and CPSIA, and we embroider eyes rather than using hard parts for young children. (Placeholder: replace with your real certifications.)"),
  },
  {
    q: t("Do you ship internationally?"),
    a: t("Yes. We ship worldwide, and each collection page shows delivery times and holiday deadlines for your country."),
  },
];
---
<BaseLayout
  locale={locale}
  route={route}
  title={t("Custom Plush Toys Designed In-House | Company Mascots, Seasonal & Photo Plush | Snugglecraft")}
  description={t("Snugglecraft is a plush design studio. We design custom plush mascots from your logo, seasonal plush collections, and cartoon plush dolls made from your photos. Shipping worldwide.")}
  ogTitle={t("Snugglecraft: plush toys designed around your story")}
  ogDescription={t("Custom company mascots, seasonal collections and photo-to-plush characters, all designed in-house.")}
  ogImage="assets/concept/burrow-mole-v04-hero-1400.jpg"
  ogImageAlt={t("3D concept rendering of Burrow Mole, Snugglecraft's original plush character (option A, v0.4). Not a photograph of a manufactured sample.")}
  ogImageSize={[1400, 1100]}
  notice={t("Prototype site: prices, figures and certifications are placeholders. Nothing is charged or sent.")}
  jsonLd={jsonLd}
>
  <section class="home-hero" aria-labelledby="hero-h">
    <div class="wrap home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">{t("Original plush design studio")}</p>
        <h1 id="hero-h">{t("Plush toys designed around your story")}</h1>
        <p class="lead">{t("We turn company logos into mascots, design seasonal collections, and make cartoon plush from your photos. Our own designers draw every character.")}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#collections">{t("Choose an offering")}</a>
          <a class="text-link" href={link('corporate', route, locale, 'quote')}>{t("Request a quote")} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ConceptFigure
        locale={locale}
        role="hero"
        class="home-hero-figure"
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 1180px) 520px, (min-width: 900px) 44vw, (min-width: 600px) 560px, calc(100vw - 40px)"
      >
        <span>{t("Burrow Mole, one of our original characters · 3D concept rendering, not a photograph of a manufactured sample.")}</span>
      </ConceptFigure>
    </div>
  </section>

  <section class="section" id="collections" aria-labelledby="col-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="col-h">{t("Three ways to start")}</h2>
        <p>{t("Each offering has its own page, with an interactive preview you can try first.")}</p>
      </div>
      <ul class="offerings">
        {OFFERINGS.map(o => (
          <li class="offering">
            <div class="offering-art">
              <img src={url(o.img.src)} width={o.img.w} height={o.img.h} alt={o.img.alt} loading="lazy" decoding="async" />
            </div>
            <p class="offering-kicker">{o.kicker}</p>
            <h3><a href={link(o.to, route, locale)}>{o.title}</a></h3>
            <p>{o.text}</p>
            <span class="offering-more" aria-hidden="true">{o.more} →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-tint" id="studio" aria-labelledby="studio-h">
    <div class="wrap studio-teaser">
      <div>
        <h2 id="studio-h">{t("Designed in-house, step by step")}</h2>
        <p>{t("We don't resell catalog toys. Our team draws every character, writes the sewing pattern and checks the sample before anything goes into production.")}</p>
        <a class="text-link" href={link('studio', route, locale, 'concepts')}>{t("See our original concepts")} <span aria-hidden="true">→</span></a>
      </div>
      <ol class="steps">
        {STEPS.map(([title, d]) => <li><strong>{title}</strong><span>{d}</span></li>)}
      </ol>
    </div>
  </section>

  <Faq heading={t("Frequently asked questions")} items={FAQ} />

  <section class="section closing" aria-labelledby="cta-h">
    <div class="wrap closing-inner">
      <h2 id="cta-h">{t("Have an idea for a plush?")}</h2>
      <p>{t("Send us a sketch, a logo or a photo and we'll reply with a free digital design proposal.")}</p>
      <a class="btn btn-primary" href={link('corporate', route, locale, 'quote')}>{t("Request a quote")}</a>
    </div>
  </section>
</BaseLayout>
